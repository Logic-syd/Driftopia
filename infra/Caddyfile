{
	email {$ACME_EMAIL}
	admin off
	servers {
		max_header_size 16kb
		timeouts {
			read_header 10s
			idle 60s
		}
	}
}
{$DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}
	# Metrics contain operational details and are only exposed inside the network.
	handle /api/metrics {
		respond 404
	}
	@backend path /api/* /socket.io/*
	handle @backend {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3001
	}
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
