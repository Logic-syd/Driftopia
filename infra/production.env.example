# Copy to /opt/driftopia/.env.production, chmod 600. Never commit the real file.
# Use openssl rand -hex 32 independently for each secret (URL-safe hex only).
DOMAIN=play.example.com
ACME_EMAIL=operator@example.com
# Bootstrap administrator is used only inside PostgreSQL for initialization/restore.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
POSTGRES_APP_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
METRICS_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Exact release commit tags or sha256 digests; never latest.
API_IMAGE=ghcr.io/logic-syd/driftopia-api:COMMIT_SHA
WEB_IMAGE=ghcr.io/logic-syd/driftopia-web:COMMIT_SHA
# Optional internal Prometheus profile; file must contain METRICS_TOKEN only.
METRICS_TOKEN_FILE=./secrets/metrics-token
GUEST_ENABLED=true
GUEST_TOTAL_LIMIT=500
GUEST_DAILY_LIMIT=100
GUEST_TTL_HOURS=24
AUTH_MAX_CONCURRENCY=8
DB_POOL_MAX=20
WS_MAX_CONNECTIONS=600
WS_MAX_PER_IP=100
