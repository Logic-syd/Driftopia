DATABASE_URL=postgresql://driftopia:driftopia_dev@127.0.0.1:5432/driftopia?schema=public
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
NODE_ENV=development
# Optional: set an existing registered account email, then run pnpm db:seed.
ADMIN_EMAIL=

# Development defaults. Production uses infra/production.env.example and HTTPS.
DB_POOL_MAX=20
GUEST_ENABLED=true
GUEST_DAILY_LIMIT=100
GUEST_TOTAL_LIMIT=500
GUEST_TTL_HOURS=24
AUTH_MAX_CONCURRENCY=8
# Only trust an actual reverse proxy IP/CIDR. Empty means no forwarded headers.
TRUST_PROXY=
HTTP_RATE_LIMIT=240
AUTH_RATE_LIMIT=10
GUEST_RATE_LIMIT=3
WS_MAX_CONNECTIONS=1000
WS_MAX_PER_IP=600
WS_MAX_PER_USER=4
# Set a random 32+ character secret through the deployment secret store.
# METRICS_TOKEN=
